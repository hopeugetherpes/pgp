{
  "name": "pgp",
  "version": "0.1.0",
  "private": true,
  "license": "CC0-1.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --config vite.static.config.ts",
    "build": "pnpm run build:static",
    "build:static": "vite build --config vite.static.config.ts && node scripts/create-standalone.mjs",
    "build:vercel": "pnpm run build:static && node scripts/verify-vercel-output.mjs",
    "check": "tsc --noEmit",
    "preview": "vite preview --config vite.static.config.ts",
    "verify:vercel": "node scripts/verify-vercel-output.mjs",
    "sign:standalone": "node scripts/sign-standalone.mjs",
    "start": "pnpm run preview"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "openpgp": "^6.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
